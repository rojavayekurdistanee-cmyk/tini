{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:profiles": "node --test test/public_profiles.test.js",
    "test:privacy:emulator": "node --test --test-concurrency=1 test/profile_privacy.emulator.test.js"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.21.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "nodemailer": "^10.3.1"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0"
  }
}
